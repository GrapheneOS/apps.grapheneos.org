#!/bin/bash

set -o errexit -o nounset -o pipefail

if [[ $# -eq 1 ]]; then
    fd=$1
else
    touch lock
    exec {fd}< lock
fi

if ! flock -n $fd; then
    echo deploy_static already locked >&2
    exit 1
fi

rm -rf static-tmp
cp -a static static-tmp

# drop unused files while preserving directory timestamps
rsync -at \
    --exclude '*.aapt2-badging' \
    --exclude '*.cert-digest' \
    --exclude '*.ina.skip' \
    --exclude '*.ina.test' \
    --exclude '*.ina.tmp' \
    --exclude '*.sha256'  \
    --exclude '*.toml' \
    --exclude '*.write_text_tmp' \
    apps/ static-tmp

zopfli_preserve_time() {
    zopfli "$1"
    touch -r "$1" "$1.gz"
}
export -f zopfli_preserve_time

find static-tmp -regex '.+\.\(ico\|json\|sjson\|svg\)' |
    parallel -q ::: brotli zopfli_preserve_time :::: -
